{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "cleanUrls": true,
  "trailingSlash": false,
  "ignoreCommand": "node scripts/should-build.mjs",
  "crons": [
    {
      "path": "/api/agents/audit",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/outbox-worker",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/health",
      "schedule": "0 */6 * * *"
    }
  ]
}
