#!/usr/bin/env sh
# Pre-push: valida que el código pase typecheck, lint, tests, e2e y tokens.
# Detiene el push si cualquier comando falla.
#
# Para saltar e2e en local (ej. sin build previo): SKIP_E2E=1 git push

set -e

echo "▸ branch name..."
bash .husky/branch-name-check.sh

echo "▸ typecheck..."
pnpm typecheck

echo "▸ lint..."
pnpm lint

echo "▸ test:coverage..."
pnpm test:coverage

echo "▸ validate tokens..."
bash scripts/validate-tokens.sh

if [ "$SKIP_E2E" != "1" ]; then
  echo "▸ e2e (Playwright)..."
  pnpm e2e
else
  echo "⊘ e2e (omitido vía SKIP_E2E=1)"
fi

echo "✓ pre-push OK"